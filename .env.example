# ======================================================
# UNIVERSAL MUSIC DOWNLOADER BOT CONFIGURATION
# ======================================================

# Obtain your bot token from @BotFather on Telegram (https://t.me/BotFather)
BOT_TOKEN=

# (Optional) Your bot username without @ symbol (e.g. MyMusicDownloaderBot)
BOT_USERNAME=

# Audio Quality: 320 (Best studio quality), 256, 192 kbps MP3
AUDIO_QUALITY=320

# Number of search results retrieved per query (default 10)
MAX_SEARCH_RESULTS=10

# Number of tracks displayed per page (default 5)
PAGE_SIZE=5
